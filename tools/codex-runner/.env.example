# Codex runner 配置（复制为 .env 并按本机填写；.env 不入库）
PLANE_URL=http://localhost
PLANE_WORKSPACE=workingcatpet
PLANE_PROJECT=4c9803a4-e542-4213-b04b-57628bc5bee9
RUNNER_PORT=9399

# 工作区 webhook 的 secret（创建 webhook 后从响应读取填入；留空则不校验签名）
WEBHOOK_SECRET=

# 管理员 token（仅用于创建/管理 webhook，可留空）
PLANE_ADMIN_TOKEN=

# 默认目标仓库（任务描述未写"仓库："时使用）
CODEX_DEFAULT_REPO=WeatherPetUnity

# 单任务 codex exec 超时（分钟）
CODEX_TIMEOUT_MIN=15

# 调试：1=不真正执行 codex exec（编排演练）
RUNNER_DRY_RUN=0

# 仓库绝对路径映射（key=仓库名大写去符号）
REPO_WEATHERPETUNITY=D:\_Code\Client\WeatherPet\WeatherPetUnity
REPO_BGLOCATION=D:\_Code\Client\WeatherPet\bglocation
REPO_WEATHERPETDIALOGUEEDITOR=D:\_Code\Client\WeatherPet\weatherpet-dialogue-editor
