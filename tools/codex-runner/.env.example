# Codex runner 配置（复制为 .env 并按本机填写；.env 不入库）
PLANE_URL=http://localhost

# 多项目模式：请复制 projects.example.json 为 projects.json 并在其中配置
# 工作区/项目列表、全局仓库池与各项目仓库。PLANE_WORKSPACE/PLANE_PROJECT/REPO_*
# 仅在无 projects.json 时作为单项目兼容模式生效。
PLANE_WORKSPACE=workingcatpet
PLANE_PROJECT=4c9803a4-e542-4213-b04b-57628bc5bee9
RUNNER_PORT=9399

# 工作区 webhook 的 secret（创建 webhook 后从响应读取填入；留空则不校验签名）
WEBHOOK_SECRET=

# 管理员 token（仅用于创建/管理 webhook，可留空）
PLANE_ADMIN_TOKEN=

# 默认目标仓库（任务描述未写"仓库："时使用）
CODEX_DEFAULT_REPO=WeatherPetUnity

# 单任务 codex exec 超时（分钟）
CODEX_TIMEOUT_MIN=15

# 会话 resume 超时（分钟，支持小数）。resume 卡住时超时后自动降级为新开会话，
# 避免流程阻塞（如 CLI resume 在 Windows 上挂起）。
RESUME_TIMEOUT_MIN=1.5

# 单个环节新会话（create）超时（分钟，支持小数）。子进程偶发消失/卡住时
# 超时后按环节失败处理，避免流程永久挂起。
STEP_TIMEOUT_MIN=5

# 调试：1=不真正执行 codex exec（编排演练）
RUNNER_DRY_RUN=0

# codex CLI 入口（node codex.js 的绝对路径）。
# 不配置时按 PATH 自动查找 codex.cmd；若 PATH 里解析到桌面版 Codex 应用
# （WindowsApps 的 codex.exe），runner 会拿不到输出而卡住，务必显式配置。
CODEX_BIN=C:\Users\<user>\.easy-ai\npm-global\node_modules\@openai\codex\bin\codex.js
